# Dedicated test credentials only. Never place production account/session here.
# Copy to .env locally; .env is ignored by Git.

# Shared Telegram application credentials for the test environment.
TELEGRAM_TEST_API_ID=
TELEGRAM_TEST_API_HASH=

# Each candidate must use an independently-created session from a dedicated test account.
# Do not paste either value into chat, logs, or committed files.
TELETHON_TEST_SESSION=
TELEPROTO_TEST_SESSION=

# Controlled test targets, never real customer targets.
TELEGRAM_TEST_PUBLIC_TARGET=
TELEGRAM_TEST_DISCUSSION_CHANNEL=
